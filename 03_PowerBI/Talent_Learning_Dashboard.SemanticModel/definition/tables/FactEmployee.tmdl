/// Fact table. Grain: one row per employee (point-in-time snapshot). Foreign keys + numeric columns for DAX measures.
table FactEmployee
	lineageTag: ca6ac1cd-52bb-50ef-862d-5b44ae32e333

	/// Unique employee identifier (EmployeeNumber in the source).
	column EmployeeID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fb716dfe-056f-59ca-b9e4-4e1233f38422
		summarizeBy: none
		sourceColumn: EmployeeID

		annotation SummarizationSetBy = User

	column DepartmentKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dda967cc-1c24-533c-b076-23361818dc38
