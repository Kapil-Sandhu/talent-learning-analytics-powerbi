model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProjectFolder","fnGetLookup","fnBandKey","src_HR","lkp_Education","lkp_Satisfaction","lkp_WorkLifeBalance","lkp_PerformanceRating","lkp_BusinessTravel","lkp_AgeBand","lkp_TenureBand","lkp_IncomeBand","lkp_TrainingBand","stg_HR","DimDepartment","DimJobRole","DimEducation","DimJobSatisfaction","DimAgeBand","DimTenureBand","DimIncomeBand","DimTrainingBand","DimEmployee","FactEmployee","QA_Checks","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDepartment
ref table DimJobRole
ref table DimEducation
ref table DimJobSatisfaction
ref table DimAgeBand
ref table DimTenureBand
ref table DimIncomeBand
ref table DimTrainingBand
ref table DimEmployee
ref table FactEmployee
ref table QA_Checks
ref table _Measures

ref cultureInfo en-US

