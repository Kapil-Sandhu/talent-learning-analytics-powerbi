/// Root folder of the project (a trailing backslash is optional). Change this one value if you move the project.
expression ProjectFolder = "D:\Ai Projects\Power BI\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 703c1d1f-623c-5bce-b1ee-ad98e1a3f789

	annotation PBI_ResultType = Text

/// Returns one Excel TABLE (by its table name, e.g. "Lkp_Education") from 01_Data\lookups\HR_Lookups.xlsx.
expression fnGetLookup =
		(TableName as text) as table =>
		let
		    Folder   = if Text.EndsWith(ProjectFolder, "\") then ProjectFolder else ProjectFolder & "\",   // works with or without trailing \
		    Source   = Excel.Workbook(File.Contents(Folder & "01_Data\lookups\HR_Lookups.xlsx"), true, true),
		    Selected = Table.SelectRows(Source, each [Kind] = "Table" and [Name] = TableName),
		    Result   = if Table.RowCount(Selected) = 1
		               then Selected{0}[Data]
		               else error Error.Record("Lookup not found", "Table '" & TableName & "' was not found in HR_Lookups.xlsx")
		in
		    Result
	lineageTag: ebf98c9d-3069-5758-a9a5-7a38948ee366

	annotation PBI_ResultType = Function

/// Returns the BandKey of the single band where Min <= Value <= Max. Raises an error if the value falls in no band or in more than one band (so bad band tables never load silently).
expression fnBandKey =
		(Value as nullable number, Bands as table) as nullable number =>
		let
		    Matches = Table.SelectRows(Bands, each [Min] <= Value and Value <= [Max]),
		    Count   = Table.RowCount(Matches),
		    Key     = if Value = null then null
		              else if Count = 1 then Matches{0}[BandKey]
		              else error Error.Record("Band lookup failed",
		                         "Value " & Number.ToText(Value) & " matches " & Number.ToText(Count) & " bands")
		in
		    Key
	lineageTag: 76e8bf32-a584-5cad-bf15-28d659a3b901

	annotation PBI_ResultType = Function

/// Reads the raw CSV. Encoding 65001 = UTF-8, which also removes the BOM in front of the first header ("Age"). Every one of the 35 columns gets an explicit data type (no automatic type detection).
expression src_HR =
		let
		    Folder   = if Text.EndsWith(ProjectFolder, "\") then ProjectFolder else ProjectFolder & "\",   // works with or without trailing \
		    Source   = Csv.Document(
		                   File.Contents(Folder & "01_Data\raw\WA_Fn-UseC_-HR-Employee-Attrition.csv"),
		                   [Delimiter = ",", Columns = 35, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed    = Table.TransformColumnTypes(Promoted, {
		                   {"Age", Int64.Type}, {"Attrition", type text}, {"BusinessTravel", type text},
		                   {"DailyRate", Int64.Type}, {"Department", type text}, {"DistanceFromHome", Int64.Type},
		                   {"Education", Int64.Type}, {"EducationField", type text}, {"EmployeeCount", Int64.Type},
		                   {"EmployeeNumber", Int64.Type}, {"EnvironmentSatisfaction", Int64.Type}, {"Gender", type text},
		                   {"HourlyRate", Int64.Type}, {"JobInvolvement", Int64.Type}, {"JobLevel", Int64.Type},
		                   {"JobRole", type text}, {"JobSatisfaction", Int64.Type}, {"MaritalStatus", type text},
		                   {"MonthlyIncome", Int64.Type}, {"MonthlyRate", Int64.Type}, {"NumCompaniesWorked", Int64.Type},
		                   {"Over18", type text}, {"OverTime", type text}, {"PercentSalaryHike", Int64.Type},
		                   {"PerformanceRating", Int64.Type}, {"RelationshipSatisfaction", Int64.Type},
		                   {"StandardHours", Int64.Type}, {"StockOptionLevel", Int64.Type}, {"TotalWorkingYears", Int64.Type},
		                   {"TrainingTimesLastYear", Int64.Type}, {"WorkLifeBalance", Int64.Type}, {"YearsAtCompany", Int64.Type},
		                   {"YearsInCurrentRole", Int64.Type}, {"YearsSinceLastPromotion", Int64.Type},
		                   {"YearsWithCurrManager", Int64.Type}}, "en-US")
		in
		    Typed
	lineageTag: 6d36beae-ebbc-5c36-b01e-72bbb2a11db8

	annotation PBI_ResultType = Table

/// Code -> label mapping table Lkp_Education from HR_Lookups.xlsx.
expression lkp_Education =
		let
		    Source   = fnGetLookup("Lkp_Education"),
		    Typed    = Table.TransformColumnTypes(Source, {{"EducationCode", Int64.Type}, {"EducationLevel", type text}, {"SortOrder", Int64.Type}}),
		    Buffered = Table.Buffer(Typed)
		in
		    Buffered
	lineageTag: dab33614-3126-5584-bc19-ef0b7d0ac506

	annotation PBI_ResultType = Table

